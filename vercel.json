{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/audio/index.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/audio/(.*)\\.mp3", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/livres/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
